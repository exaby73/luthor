---
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <svg
    class="mark"
    width="26"
    height="26"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M5.5 3v16.5h7.75L21 9.75"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="square"
      stroke-linejoin="miter"
    ></path>
  </svg>
  <span class="wordmark" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--sl-color-white);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .mark {
    flex: 0 0 auto;
    color: var(--sl-color-accent);
  }

  .site-title:hover .wordmark,
  .site-title:focus-visible .wordmark {
    text-decoration: underline;
    text-decoration-color: var(--sl-color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .site-title:focus-visible {
    outline: 2px solid transparent;
    box-shadow:
      -6px 0 0 -1px var(--sl-color-accent),
      6px 0 0 -1px var(--sl-color-accent);
  }
</style>
